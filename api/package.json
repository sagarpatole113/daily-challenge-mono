{
  "name": "@mpsc/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "predev": "node scripts/copy-shared.js",
    "dev": "tsx watch src/server.ts",
    "prebuild": "node scripts/copy-shared.js",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "postbuild": "node scripts/verify-build.js",
    "start": "node dist/server.js",
    "pretypecheck": "node scripts/copy-shared.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.3.1",
    "helmet": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
     "tsc-alias": "^1.8.10"
  }
}