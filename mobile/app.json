{
  "expo": {
    "name": "सातत्य",
    "slug": "saatatya",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "saatatya",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saatatya.app"
    },
    "android": {
      "package": "com.saatatya.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7420ff75-a3df-4e91-82d6-b9b3ab449c8b"
      }
    },
    "owner": "sagarpatole113"
  }
}
